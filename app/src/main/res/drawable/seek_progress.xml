<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="3dp" android:bottom="3dp">
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="2dp" /><size android:height="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item><shape><solid android:color="#1FFFFFFF" /><corners android:radius="5dp" /><size android:height="9dp" /></shape></item>
                <item android:top="2dp" android:bottom="2dp"><shape><solid android:color="#45FFFFFF" /><corners android:radius="3dp" /></shape></item>
                <item android:top="3dp" android:bottom="3dp"><shape><solid android:color="#FFFFFF" /><corners android:radius="2dp" /></shape></item>
            </layer-list>
        </clip>
    </item>
</layer-list>
